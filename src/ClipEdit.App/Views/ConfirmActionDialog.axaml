<Window
    x:Class="ClipEdit.App.Views.ConfirmActionDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    Height="190"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="#181B22">
  <Grid Margin="24" RowDefinitions="*,Auto" RowSpacing="20">
    <TextBlock
        x:Name="MessageText"
        VerticalAlignment="Center"
        FontSize="14"
        Foreground="#E9EAF0"
        TextWrapping="Wrap" />
    <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
      <Button x:Name="CancelButton" Padding="16,9" Click="Cancel_Click" Content="Cancel" />
      <Button x:Name="ConfirmButton" Padding="16,9" Click="Confirm_Click" />
    </StackPanel>
  </Grid>
</Window>
