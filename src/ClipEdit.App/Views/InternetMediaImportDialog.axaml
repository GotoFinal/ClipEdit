<Window
    x:Class="ClipEdit.App.Views.InternetMediaImportDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:internet="using:ClipEdit.App.InternetMedia"
    Width="540"
    Height="420"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Import from link"
    Background="#181B22">
  <Grid Margin="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="3">
      <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#F2F3F7" Text="Import media from the internet" />
      <TextBlock
          x:Name="SourceUrlText"
          MaxWidth="500"
          Classes="muted"
          FontSize="10"
          TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="2">
      <TextBlock x:Name="MediaTitleText" FontSize="14" FontWeight="SemiBold" Text="Checking link…" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="MediaDetailText" Classes="muted" FontSize="10" />
    </StackPanel>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="140,*" ColumnSpacing="10" RowSpacing="8">
      <TextBlock VerticalAlignment="Center" Text="Video quality" />
      <ComboBox
          x:Name="VideoQualityComboBox"
          Grid.Column="1"
          IsEnabled="False">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="internet:InternetVideoQualityChoice">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Audio quality" />
      <ComboBox
          x:Name="AudioQualityComboBox"
          Grid.Row="1"
          Grid.Column="1"
          IsEnabled="False">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="internet:InternetAudioQualityChoice">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock
          Grid.Row="2"
          VerticalAlignment="Center"
          Text="Streaming preview" />
      <ComboBox
          x:Name="PreviewQualityComboBox"
          Grid.Row="2"
          Grid.Column="1"
          IsEnabled="True">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding StringFormat={}{0}p}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock
          Grid.Row="3"
          Grid.ColumnSpan="2"
          Classes="muted"
          FontSize="10"
          Text="Final quality downloads in the background and is used for export. Streaming quality only affects preview bandwidth."
          TextWrapping="Wrap" />

      <StackPanel Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Spacing="6">
        <ProgressBar x:Name="DownloadProgressBar" Height="5" Minimum="0" Maximum="1" IsIndeterminate="True" />
        <TextBlock x:Name="StatusText" Classes="muted" FontSize="10" Text="Preparing yt-dlp…" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button
          x:Name="CancelButton"
          Grid.Column="1"
          MinWidth="76"
          Padding="12,6"
          Classes="secondary"
          Click="Cancel_Click"
          Content="Cancel" />
      <Button
          x:Name="DownloadButton"
          Grid.Column="2"
          MinWidth="104"
          Padding="12,6"
          Classes="primary"
          Click="Download_Click"
          Content="Start editing"
          IsEnabled="False" />
    </Grid>
  </Grid>
</Window>
