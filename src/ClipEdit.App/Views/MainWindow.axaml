<Window
    x:Class="ClipEdit.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClipEdit.App.Controls"
    xmlns:mediaExport="using:ClipEdit.Media.Export"
    xmlns:vm="using:ClipEdit.App.ViewModels"
    Title="{Binding ProductName}"
    Width="1240"
    Height="800"
    MinWidth="900"
    MinHeight="620"
    Background="#111318"
    DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C5CFC" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#252936" />
      <Setter Property="Foreground" Value="#E9EAF0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#181B22" />
      <Setter Property="BorderBrush" Value="#303543" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D93A5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,38">
    <Border
        Grid.Row="0"
        Padding="22,0"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="32" Height="32" Background="#7C5CFC" CornerRadius="9">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="C" />
          </Border>
          <TextBlock
              VerticalAlignment="Center"
              FontSize="19"
              FontWeight="SemiBold"
              Text="{Binding ProductName}" />
          <Border Padding="8,4" Background="#242033" CornerRadius="6">
            <TextBlock
                FontSize="10"
                FontWeight="Bold"
                Foreground="#B7A9FF"
                Text="{Binding EditingModeText}" />
          </Border>
          <Button
              Classes="secondary"
              Click="NewProject_Click"
              Content="New project"
              IsEnabled="{Binding CanNewProject}" />
          <Button
              Classes="secondary"
              Click="OpenProject_Click"
              Content="Open project"
              IsEnabled="{Binding CanOpenProject}" />
          <Button
              Classes="secondary"
              Click="SaveProject_Click"
              Content="Save"
              IsEnabled="{Binding CanSaveProject}" />
        </StackPanel>

        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#AEB3C2"
            Text="{Binding WorkspaceTitle}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <ComboBox
              Width="176"
              ItemsSource="{Binding ExportPresets}"
              SelectedItem="{Binding SelectedExportPreset}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="mediaExport:ExportPreset">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button
              Classes="primary"
              Click="Export_Click"
              Content="Export"
              IsEnabled="{Binding CanExport}"
              ToolTip.Tip="{Binding ExportAvailabilityText}" />
          <Button
              Classes="secondary"
              Click="CancelExport_Click"
              Content="Cancel"
              IsVisible="{Binding CanCancelExport}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20" ColumnDefinitions="250,*" ColumnSpacing="18">
      <Border Grid.Column="0" Classes="panel" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="PROJECT MEDIA" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#777E91"
                Text="{Binding MediaItems.Count}" />
          </Grid>

          <ListBox
              Grid.Row="1"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding MediaItems}"
              SelectedItem="{Binding SelectedMedia}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MediaItemViewModel">
                <Border Margin="0,0,0,8" Padding="10" Background="#20242D" CornerRadius="8">
                  <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
                    <Border
                        Width="34"
                        Height="34"
                        Background="#2B3040"
                        CornerRadius="7">
                      <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="#A996FF"
                          Text="◆" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding DisplayName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Button
                Classes="secondary"
                Click="OpenMedia_Click"
                Content="＋ Add media"
                IsEnabled="{Binding IsImportAvailable}" />
            <Button
                Classes="secondary"
                Click="RemoveSelectedMedia_Click"
                Content="− Remove selected"
                IsEnabled="{Binding CanRemoveSelectedMedia}"
                ToolTip.Tip="Removes the selected item from this project; the source file stays untouched" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Border
            Classes="panel"
            IsVisible="{Binding ShowEmptyState}">
          <Grid Margin="28">
            <Border
                MaxWidth="650"
                MaxHeight="380"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#151820"
                BorderBrush="#4C5264"
                BorderThickness="1"
                CornerRadius="18">
              <StackPanel HorizontalAlignment="Center" Spacing="16">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="#242033"
                    CornerRadius="36">
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="34"
                      Foreground="#A996FF"
                      Text="▶" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding EmptyStateTitle}" />
                <TextBlock
                    MaxWidth="470"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding EmptyStateDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Classes="primary"
                    Click="OpenMedia_Click"
                    Content="Open media"
                    IsEnabled="{Binding IsImportAvailable}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#767D91"
                    Text="{Binding SupportedMediaHint}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid
            RowDefinitions="*,Auto"
            RowSpacing="14"
            IsVisible="{Binding ShowQuickWorkspace}">
          <Border Classes="panel" Padding="18">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="10">
              <Border Background="#0B0D12" CornerRadius="8">
                <Grid>
                  <Image
                      Margin="8"
                      IsVisible="{Binding HasPreviewImage}"
                      Source="{Binding PreviewImage}"
                      Stretch="Uniform" />

                  <controls:MpvVideoView
                      x:Name="LivePreview"
                      Margin="8"
                      AudioTracks="{Binding PreviewAudioTracks}"
                      HasCuts="{Binding SelectedMedia.IsEdited}"
                      IsPaused="True"
                      PlaybackRanges="{Binding SelectedMedia.KeptRanges}"
                      Position="{Binding SelectedMedia.Playhead, Mode=TwoWay}"
                      SourcePath="{Binding SelectedMedia.SourcePath}" />

                  <controls:CropCanvas
                      Margin="8"
                      AutomationProperties.Name="Video crop selection"
                      Crop="{Binding SelectedMedia.Crop, Mode=TwoWay}"
                      IsOverlayOnly="True"
                      ZIndex="10"
                      SourceSize="{Binding SelectedMedia.VideoSize}"
                      ToolTip.Tip="Drag inside the crop to move it; drag a handle to resize" />

                  <StackPanel
                      HorizontalAlignment="Center"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center"
                      Spacing="10"
                      IsVisible="{Binding ShowPreviewPlaceholder}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="42"
                        Foreground="#5D6374"
                        Text="▶" />
                    <TextBlock
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedMedia.DisplayName}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="muted"
                        Text="{Binding SelectedMedia.Summary}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#6F7689"
                        Text="Decoding source frame…"
                        IsVisible="{Binding IsPreviewLoading}" />
                    <TextBlock
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#E28B8B"
                        Text="{Binding PreviewErrorText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasPreviewError}" />
                  </StackPanel>

                  <Border
                      Margin="14"
                      Padding="8,5"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      ZIndex="20"
                      VerticalAlignment="Top"
                      Background="#B3151820"
                      CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontSize="10" Foreground="#AEB3C2" Text="SOURCE PREVIEW" />
                      <TextBlock
                          MaxWidth="520"
                          FontSize="10"
                          Foreground="#8D93A5"
                          Text="{Binding PlaybackStatus, ElementName=LivePreview}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          FontSize="10"
                          Foreground="#7C5CFC"
                          Text="{Binding DecoderStatus, ElementName=LivePreview}" />
                      <TextBlock
                          FontSize="10"
                          Foreground="#E3B341"
                          IsVisible="{Binding HasCuts, ElementName=LivePreview}"
                          Text="Cut preview sampled · export exact" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Slider
                  Grid.Row="1"
                  AutomationProperties.Name="Source playhead"
                  IsEnabled="{Binding SelectedMedia.HasEditableDuration}"
                  Maximum="{Binding SelectedMedia.SourceDurationSeconds}"
                  Minimum="0"
                  Value="{Binding SelectedMedia.PlayheadSeconds, Mode=TwoWay}" />

              <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="{Binding SelectedMedia.PlayheadText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Click="GoToStart_Click" Content="│◀" />
                  <Button
                      AutomationProperties.Name="Previous source frame"
                      Classes="secondary"
                      Click="StepFrameBackward_Click"
                      Content="◀"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="Previous source frame (best effort)" />
                  <Button
                      Classes="primary"
                      Click="TogglePlayback_Click"
                      Content="{Binding PlayButtonText, ElementName=LivePreview}"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="{Binding PlaybackStatus, ElementName=LivePreview}" />
                  <Button
                      AutomationProperties.Name="Next source frame"
                      Classes="secondary"
                      Click="StepFrameForward_Click"
                      Content="▶"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="Next source frame" />
                  <Button Classes="secondary" Click="GoToEnd_Click" Content="▶│" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="muted"
                    FontSize="11"
                    Text="{Binding SelectedMedia.Detail}" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="panel" Padding="14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock FontSize="11" FontWeight="Bold" Text="EDIT" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="10"
                    Foreground="#777E91"
                    Text="{Binding EditingModeText}" />
              </Grid>

              <Border
                  Height="104"
                  Background="#20242D"
                  CornerRadius="7"
                  IsVisible="{Binding ShowRangeStrip}">
                <Grid Margin="8" ColumnDefinitions="90,*" RowDefinitions="24,*" RowSpacing="4">
                  <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Spacing="3">
                    <TextBlock Classes="muted" FontSize="11" Text="SOURCE RANGE" />
                    <TextBlock Classes="muted" FontSize="9" Text="{Binding SelectedMedia.TimelineViewportText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="muted"
                        FontSize="9"
                        IsVisible="{Binding SelectedMedia.IsTimelineLoading}"
                        Text="Generating timeline previews…" />
                    <Button
                        Grid.Column="1"
                        Padding="8,1"
                        Classes="secondary"
                        Click="TimelineZoomOut_Click"
                        Content="−"
                        IsEnabled="{Binding SelectedMedia.CanZoomTimelineOut}"
                        ToolTip.Tip="Zoom out" />
                    <TextBlock Grid.Column="2" MinWidth="35" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding SelectedMedia.TimelineZoomText}" />
                    <Button
                        Grid.Column="3"
                        Padding="8,1"
                        Classes="secondary"
                        Click="TimelineZoomIn_Click"
                        Content="+"
                        IsEnabled="{Binding SelectedMedia.CanZoomTimelineIn}"
                        ToolTip.Tip="Zoom in" />
                    <Button Grid.Column="4" Padding="8,1" Classes="secondary" Click="TimelineFit_Click" Content="Fit" IsEnabled="{Binding SelectedMedia.CanZoomTimelineOut}" />
                  </Grid>
                  <controls:SourceRangeCanvas
                      Grid.Column="1"
                      Grid.Row="1"
                      Margin="8,0"
                      AutomationProperties.Name="Kept source ranges and cut selection"
                      AutomationProperties.HelpText="Wheel zooms around the pointer. Shift wheel or middle drag pans. Drag either white selection edge for live trim preview."
                      Duration="{Binding SelectedMedia.SourceDurationSeconds}"
                      KeptRanges="{Binding SelectedMedia.KeptRanges}"
                      Playhead="{Binding SelectedMedia.PlayheadSeconds, Mode=TwoWay}"
                      SelectionEnd="{Binding SelectedMedia.SelectionEndSeconds, Mode=TwoWay}"
                      SelectionStart="{Binding SelectedMedia.SelectionStartSeconds, Mode=TwoWay}"
                      Step="{Binding SelectedMedia.FrameStepSeconds}"
                      ThumbnailFrames="{Binding SelectedMedia.TimelineThumbnails}"
                      ToolTip.Tip="Wheel to zoom · Shift+wheel or middle-drag to pan · drag white edges to trim"
                      ViewportStart="{Binding SelectedMedia.TimelineViewportStart, Mode=TwoWay}"
                      Zoom="{Binding SelectedMedia.TimelineZoom, Mode=TwoWay}" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowRangeStrip}">
                <Button Classes="secondary" Click="MarkIn_Click" Content="Mark in" />
                <Button Grid.Column="1" Classes="secondary" Click="MarkOut_Click" Content="Mark out" />
                <Button
                    Grid.Column="2"
                    Classes="primary"
                    Click="RemoveSelection_Click"
                    Content="Remove selected range"
                    IsEnabled="{Binding SelectedMedia.CanRemoveSelection}" />
                <Button
                    Grid.Column="3"
                    Classes="primary"
                    Click="KeepSelectionOnly_Click"
                    Content="Keep selected only"
                    IsEnabled="{Binding SelectedMedia.CanKeepSelectionOnly}" />
                <Button
                    Grid.Column="4"
                    Classes="secondary"
                    Click="ResetCuts_Click"
                    Content="Reset cuts"
                    IsEnabled="{Binding SelectedMedia.IsEdited}" />
                <StackPanel Grid.Column="6" HorizontalAlignment="Right" Spacing="1">
                  <TextBlock HorizontalAlignment="Right" Classes="muted" FontSize="10" Text="{Binding SelectedMedia.SelectionRangeText}" />
                  <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedMedia.SelectedExportDurationText}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="80,*" IsVisible="{Binding ShowTimeline}">
                <Border Padding="8" Background="#20242D" CornerRadius="6,0,0,6">
                  <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="V1" />
                </Border>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding VideoItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MediaItemViewModel">
                        <Border
                            MinWidth="180"
                            Height="48"
                            Margin="2,0"
                            Padding="10"
                            Background="#5B45BE"
                            CornerRadius="5">
                          <TextBlock
                              VerticalAlignment="Center"
                              FontSize="11"
                              Text="{Binding DisplayName}"
                              TextTrimming="CharacterEllipsis" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="CROP" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="X" />
                <TextBox Grid.Column="2" Width="58" Text="{Binding SelectedMedia.CropX, Mode=TwoWay}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="Y" />
                <TextBox Grid.Column="4" Width="58" Text="{Binding SelectedMedia.CropY, Mode=TwoWay}" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="W" />
                <TextBox Grid.Column="6" Width="66" Text="{Binding SelectedMedia.CropWidth, Mode=TwoWay}" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="H" />
                <TextBox Grid.Column="8" Width="66" Text="{Binding SelectedMedia.CropHeight, Mode=TwoWay}" />
                <Button Grid.Column="9" Classes="secondary" Click="ResetCrop_Click" Content="Reset crop" />
                <StackPanel Grid.Column="10" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="10" Text="EXPORT" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding SelectedMedia.CropSizeText}" />
                  <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="10" Text="AUDIO" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding AudioSummaryText}" />
                  <Button
                      Classes="secondary"
                      Click="ToggleAudioMixer_Click"
                      Content="{Binding AudioMixerButtonText}"
                      IsVisible="{Binding HasAudioTracks}" />
                </StackPanel>
              </Grid>

              <Border Padding="10" Background="#151820" CornerRadius="7" IsVisible="{Binding ShowAudioMixer}">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontSize="11" FontWeight="Bold" Text="AUDIO TRACKS" />
                      <TextBlock Classes="muted" FontSize="10" Text="External placement uses timeline time" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Classes="muted" FontSize="10" Text="{Binding AudioTrackCountText}" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" MaxHeight="230" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AudioTrackViewModel">
                          <Border Margin="0,0,0,7" Padding="9" Background="#20242D" CornerRadius="6">
                            <Grid RowDefinitions="Auto,Auto,64,Auto" RowSpacing="7">
                              <Grid ColumnDefinitions="*,Auto,72,Auto,150,58" ColumnSpacing="8">
                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="10" IsVisible="{Binding IsExternal}" Text="Start (s)" />
                                <TextBox Grid.Column="2" IsVisible="{Binding IsExternal}" Text="{Binding TimelineOffsetSeconds, Mode=TwoWay}" />
                                <CheckBox Grid.Column="3" VerticalAlignment="Center" Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                                <Slider Grid.Column="4" Minimum="-60" Maximum="12" Value="{Binding GainDb, Mode=TwoWay}" />
                                <TextBlock Grid.Column="5" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Text="{Binding GainText}" />
                              </Grid>
                              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="muted" FontSize="9" Text="{Binding TimelineViewportText}" />
                                  <TextBlock Classes="muted" FontSize="9" IsVisible="{Binding IsWaveformLoading}" Text="Generating waveform…" />
                                  <TextBlock Foreground="#E88E8E" FontSize="9" IsVisible="{Binding HasWaveformError}" Text="Waveform unavailable" ToolTip.Tip="{Binding WaveformErrorText}" />
                                </StackPanel>
                                <Button Grid.Column="1" Padding="8,1" Classes="secondary" Click="AudioTimelineZoomOut_Click" Content="−" IsEnabled="{Binding CanZoomTimelineOut}" ToolTip.Tip="Zoom waveform out" />
                                <TextBlock Grid.Column="2" MinWidth="35" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding TimelineZoomText}" />
                                <Button Grid.Column="3" Padding="8,1" Classes="secondary" Click="AudioTimelineZoomIn_Click" Content="+" IsEnabled="{Binding CanZoomTimelineIn}" ToolTip.Tip="Zoom waveform in" />
                                <Button Grid.Column="4" Padding="8,1" Classes="secondary" Click="AudioTimelineFit_Click" Content="Fit" IsEnabled="{Binding CanZoomTimelineOut}" />
                              </Grid>
                              <controls:SourceRangeCanvas
                                  Grid.Row="2"
                                  AutomationProperties.Name="Audio audible ranges and silence selection"
                                  AutomationProperties.HelpText="Wheel zooms the waveform around the pointer. Shift wheel or middle drag pans."
                                  Duration="{Binding DurationSeconds}"
                                  KeptRanges="{Binding KeptRanges}"
                                  Playhead="{Binding PlayheadSeconds, Mode=TwoWay}"
                                  SelectionEnd="{Binding SelectionEndSeconds, Mode=TwoWay}"
                                  SelectionStart="{Binding SelectionStartSeconds, Mode=TwoWay}"
                                  Step="{Binding FrameStepSeconds}"
                                  ToolTip.Tip="Wheel to zoom · Shift+wheel or middle-drag to pan · waveform follows the visible range"
                                  ViewportStart="{Binding TimelineViewportStart, Mode=TwoWay}"
                                  Waveform="{Binding Waveform}"
                                  Zoom="{Binding TimelineZoom, Mode=TwoWay}" />
                              <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <Button
                                    Classes="secondary"
                                    Click="RemoveAudioSelection_Click"
                                    Content="Silence selected range"
                                    IsEnabled="{Binding CanRemoveSelection}" />
                                <Button Grid.Column="1" Classes="secondary" Click="ResetAudioTrack_Click" Content="Reset" IsEnabled="{Binding IsEdited}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="{Binding OutputDurationText}" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="16,0"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="12" VerticalAlignment="Center">
        <TextBlock FontSize="11" Foreground="#777E91" Text="Local, private, and non-destructive" />
        <ProgressBar
            Grid.Column="1"
            Height="5"
            Maximum="1"
            Value="{Binding ExportProgress}"
            IsVisible="{Binding ShowExportProgress}" />
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <TextBlock FontSize="11" Foreground="#B7A9FF" Text="{Binding ExportPhaseText}" />
          <TextBlock FontSize="11" Foreground="#A2A8B8" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
