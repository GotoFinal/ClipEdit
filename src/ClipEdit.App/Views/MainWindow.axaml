<Window
    x:Class="ClipEdit.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ClipEdit.App.ViewModels"
    Title="{Binding ProductName}"
    Width="1240"
    Height="800"
    MinWidth="900"
    MinHeight="620"
    Background="#111318"
    DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C5CFC" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="20,10" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#252936" />
      <Setter Property="Foreground" Value="#E9EAF0" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#181B22" />
      <Setter Property="BorderBrush" Value="#303543" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D93A5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,38">
    <Border
        Grid.Row="0"
        Padding="22,0"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="32" Height="32" Background="#7C5CFC" CornerRadius="9">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="C" />
          </Border>
          <TextBlock
              VerticalAlignment="Center"
              FontSize="19"
              FontWeight="SemiBold"
              Text="{Binding ProductName}" />
          <Border Padding="8,4" Background="#242033" CornerRadius="6">
            <TextBlock
                FontSize="10"
                FontWeight="Bold"
                Foreground="#B7A9FF"
                Text="{Binding EditingModeText}" />
          </Border>
        </StackPanel>

        <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="#AEB3C2"
            Text="{Binding WorkspaceTitle}" />

        <Button Grid.Column="2" Classes="secondary" Content="Export" IsEnabled="False" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20" ColumnDefinitions="250,*" ColumnSpacing="18">
      <Border Grid.Column="0" Classes="panel" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="PROJECT MEDIA" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#777E91"
                Text="{Binding MediaItems.Count}" />
          </Grid>

          <ListBox
              Grid.Row="1"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding MediaItems}"
              SelectedItem="{Binding SelectedMedia}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MediaItemViewModel">
                <Border Margin="0,0,0,8" Padding="10" Background="#20242D" CornerRadius="8">
                  <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
                    <Border
                        Width="34"
                        Height="34"
                        Background="#2B3040"
                        CornerRadius="7">
                      <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="#A996FF"
                          Text="◆" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding DisplayName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Spacing="8">
            <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Button
                Classes="secondary"
                Click="OpenMedia_Click"
                Content="＋ Add media"
                IsEnabled="{Binding IsImportAvailable}" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Border
            Classes="panel"
            IsVisible="{Binding ShowEmptyState}">
          <Grid Margin="28">
            <Border
                MaxWidth="650"
                MaxHeight="380"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#151820"
                BorderBrush="#4C5264"
                BorderThickness="1"
                CornerRadius="18">
              <StackPanel HorizontalAlignment="Center" Spacing="16">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="#242033"
                    CornerRadius="36">
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="34"
                      Foreground="#A996FF"
                      Text="▶" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding EmptyStateTitle}" />
                <TextBlock
                    MaxWidth="470"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding EmptyStateDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Classes="primary"
                    Click="OpenMedia_Click"
                    Content="Open media"
                    IsEnabled="{Binding IsImportAvailable}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#767D91"
                    Text="{Binding SupportedMediaHint}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid
            RowDefinitions="*,Auto"
            RowSpacing="14"
            IsVisible="{Binding ShowQuickWorkspace}">
          <Border Classes="panel" Padding="18">
            <Grid RowDefinitions="*,Auto" RowSpacing="12">
              <Border Background="#0B0D12" CornerRadius="8">
                <Grid>
                  <Image
                      Margin="8"
                      IsVisible="{Binding HasPreviewImage}"
                      Source="{Binding PreviewImage}"
                      Stretch="Uniform" />

                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="10"
                      IsVisible="{Binding ShowPreviewPlaceholder}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="42"
                        Foreground="#5D6374"
                        Text="▶" />
                    <TextBlock
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedMedia.DisplayName}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="muted"
                        Text="{Binding SelectedMedia.Summary}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#6F7689"
                        Text="Decoding source frame…"
                        IsVisible="{Binding IsPreviewLoading}" />
                    <TextBlock
                        MaxWidth="560"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="#E28B8B"
                        Text="{Binding PreviewErrorText}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        IsVisible="{Binding HasPreviewError}" />
                  </StackPanel>

                  <Border
                      Margin="14"
                      Padding="8,5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"
                      Background="#B3151820"
                      CornerRadius="6">
                    <TextBlock FontSize="10" Foreground="#AEB3C2" Text="SOURCE PREVIEW" />
                  </Border>
                </Grid>
              </Border>

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="00:00.000" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Classes="secondary" Content="│◀" IsEnabled="False" />
                  <Button Classes="primary" Content="▶" IsEnabled="False" />
                  <Button Classes="secondary" Content="▶│" IsEnabled="False" />
                </StackPanel>
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="muted"
                    FontSize="11"
                    Text="{Binding SelectedMedia.Detail}" />
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="panel" Padding="14">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock FontSize="11" FontWeight="Bold" Text="EDIT" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="10"
                    Foreground="#777E91"
                    Text="{Binding EditingModeText}" />
              </Grid>

              <Border
                  Height="54"
                  Background="#20242D"
                  CornerRadius="7"
                  IsVisible="{Binding ShowRangeStrip}">
                <Grid Margin="8" ColumnDefinitions="90,*">
                  <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="SOURCE RANGE" />
                  <Border Grid.Column="1" Margin="8,4" Background="#5B45BE" CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Text="Full source selected" />
                  </Border>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="80,*" IsVisible="{Binding ShowTimeline}">
                <Border Padding="8" Background="#20242D" CornerRadius="6,0,0,6">
                  <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="V1" />
                </Border>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding VideoItems}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MediaItemViewModel">
                        <Border
                            MinWidth="180"
                            Height="48"
                            Margin="2,0"
                            Padding="10"
                            Background="#5B45BE"
                            CornerRadius="5">
                          <TextBlock
                              VerticalAlignment="Center"
                              FontSize="11"
                              Text="{Binding DisplayName}"
                              TextTrimming="CharacterEllipsis" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="CROP" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding CropSizeText}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" FontSize="11" Text="AUDIO" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding AudioSummaryText}" />
              </Grid>

              <Grid ColumnDefinitions="80,*" IsVisible="{Binding ShowAudioMixer}">
                <Border Padding="8" Background="#20242D" CornerRadius="6,0,0,6">
                  <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Text="AUDIO" />
                </Border>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding ExternalAudioItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MediaItemViewModel">
                      <Border Height="38" Margin="2,0" Padding="10" Background="#306D5D" CornerRadius="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock VerticalAlignment="Center" FontSize="11" Text="{Binding DisplayName}" />
                          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Text="0.0 dB" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="16,0"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock FontSize="11" Foreground="#777E91" Text="Local, private, and non-destructive" />
        <TextBlock Grid.Column="1" FontSize="11" Foreground="#A2A8B8" Text="{Binding StatusText}" />
      </Grid>
    </Border>
  </Grid>
</Window>
