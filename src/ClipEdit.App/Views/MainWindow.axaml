<Window
    x:Class="ClipEdit.App.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ClipEdit.App.Controls"
    xmlns:chrome="using:Avalonia.Controls.Chrome"
    xmlns:mediaExport="using:ClipEdit.Media.Export"
    xmlns:vm="using:ClipEdit.App.ViewModels"
    Title="{Binding ProductName}"
    Width="1240"
    Height="800"
    MinWidth="860"
    MinHeight="680"
    Icon="/Assets/ClipEdit.ico"
    Background="#111318"
    DragDrop.AllowDrop="True">

  <Window.Styles>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7C5CFC" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#252936" />
      <Setter Property="Foreground" Value="#E9EAF0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.command-bar">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.export-menu">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#6546D7" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#927CF0" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.export-menu:pointerover">
      <Setter Property="Background" Value="#7657EA" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector=":is(Button).timeline-tool">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#181B22" />
      <Setter Property="BorderBrush" Value="#303543" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="47" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#20242D" />
      <Setter Property="Foreground" Value="#D8DAE3" />
      <Setter Property="BorderBrush" Value="#303543" />
      <Setter Property="BorderThickness" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Button.caption:pointerover">
      <Setter Property="Background" Value="#343946" />
    </Style>
    <Style Selector="Button.caption-close:pointerover">
      <Setter Property="Background" Value="#C42B1C" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.brand">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="2,2,6,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#F5F5F8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.brand:pointerover">
      <Setter Property="Background" Value="#252936" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8D93A5" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="48,*,28">
    <Border
        Grid.Row="0"
        Padding="12,0"
        x:Name="AppCommandBar"
        chrome:WindowDecorationProperties.ElementRole="TitleBar"
        PointerPressed="AppCommandBar_PointerPressed"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
        <Button
            x:Name="ProjectMenuButton"
            Classes="brand"
            ToolTip.Tip="Project menu"
            chrome:WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Image x:Name="ProjectMenuIcon" Width="28" Height="28" Source="/Assets/ClipEdit.png" />
            <TextBlock
                x:Name="ProductNameText"
                VerticalAlignment="Center"
                FontSize="17"
                FontWeight="SemiBold"
                Text="{Binding ProductName}" />
            <PathIcon Width="8" Height="8" Foreground="#8D93A5" Data="M1,2 L7,2 L4,6 Z" />
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="New project" Click="NewProject_Click" IsEnabled="{Binding CanNewProject}" />
              <MenuItem Header="Open project…" Click="OpenProject_Click" IsEnabled="{Binding CanOpenProject}" />
              <MenuItem Header="Save project" Click="SaveProject_Click" IsEnabled="{Binding CanSaveProject}" />
              <Separator />
              <MenuItem
                  x:Name="UndoMenuItem"
                  Header="Undo"
                  HotKey="Ctrl+Z"
                  Click="Undo_Click"
                  IsEnabled="{Binding CanUndo}" />
              <MenuItem
                  x:Name="RedoMenuItem"
                  Header="Redo"
                  HotKey="Ctrl+Y"
                  Click="Redo_Click"
                  IsEnabled="{Binding CanRedo}" />
              <Separator />
              <MenuItem
                  x:Name="RegisterProjectFileAssociationMenuItem"
                  Header="Use ClipEdit for .clipedit files"
                  Click="RegisterProjectFileAssociation_Click" />
              <Separator />
              <MenuItem Header="Legal notices…" Click="LegalNotices_Click" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <StackPanel x:Name="ProjectActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" chrome:WindowDecorationProperties.ElementRole="User">
          <Button
              x:Name="NewProjectButton"
              Height="30"
              Classes="secondary command-bar"
              Click="NewProject_Click"
              Content="New"
              IsEnabled="{Binding CanNewProject}" />
          <Button
              x:Name="OpenProjectButton"
              Height="30"
              Classes="secondary command-bar"
              Click="OpenProject_Click"
              Content="Open"
              IsEnabled="{Binding CanOpenProject}" />
          <Button
              x:Name="SaveProjectButton"
              Height="30"
              Classes="secondary command-bar"
              Click="SaveProject_Click"
              Content="Save"
              IsEnabled="{Binding CanSaveProject}" />
        </StackPanel>

        <StackPanel x:Name="CropToolbar" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" chrome:WindowDecorationProperties.ElementRole="User">
          <ToggleButton
              Height="30"
              Padding="9,5"
              Classes="secondary"
              Click="UseCropTool_Click"
              Content="Crop"
              IsChecked="{Binding IsCropToolActive, Mode=OneWay}"
              ToolTip.Tip="Edit the one shared output crop" />
          <ToggleButton
              Height="30"
              Padding="9,5"
              Classes="secondary"
              Click="UseTransformTool_Click"
              Content="Transform"
              IsChecked="{Binding IsTransformToolActive, Mode=OneWay}"
              ToolTip.Tip="Move, resize, or rotate the selected clip under the crop" />
          <ToggleButton
              Height="30"
              Padding="9,5"
              Classes="secondary"
              Click="UseAutoTool_Click"
              Content="Auto"
              IsChecked="{Binding IsAutoToolActive, Mode=OneWay}"
              ToolTip.Tip="Crop inside the frame; Ctrl drags the clip; clip handles always work" />
          <TextBlock x:Name="CropPresetLabel" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="CROP" />
          <ComboBox Width="132" Height="30" VerticalAlignment="Center" ItemsSource="{Binding CropAspectPresets}" SelectedItem="{Binding SelectedCropAspectPreset}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CropAspectPreset">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton
              Width="30"
              Height="30"
              Padding="6"
              Classes="secondary"
              IsChecked="{Binding IsCropAspectLocked, Mode=TwoWay}"
              ToolTip.Tip="Lock crop ratio while resizing">
            <PathIcon Width="14" Height="14" Data="M4,7 V5 A4,4 0 0 1 12,5 V7 H14 V15 H2 V7 Z M6,7 H10 V5 A2,2 0 0 0 6,5 Z" />
          </ToggleButton>
          <Button
              Width="30"
              Height="30"
              Padding="6"
              Classes="secondary"
              AutomationProperties.Name="Rotate complete canvas clockwise"
              Click="RotateCanvasClockwise_Click"
              IsEnabled="{Binding CanRotateCanvas}"
              ToolTip.Tip="Rotate the complete canvas and every clip 90° clockwise">
            <TextBlock FontSize="10" FontWeight="SemiBold" Text="90°" />
          </Button>
        </StackPanel>

        <Border
            x:Name="TitleDragRegion"
            Grid.Column="3"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
          <StackPanel x:Name="WorkspaceTitlePanel">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="#AEB3C2"
                Text="{Binding WorkspaceTitle}"
                TextTrimming="CharacterEllipsis" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasExportBlockingIssue}">
              <TextBlock
                  MaxWidth="310"
                  VerticalAlignment="Center"
                  FontSize="10"
                  Foreground="#FFB36B"
                  Text="{Binding ExportAvailabilityText}"
                  TextTrimming="CharacterEllipsis" />
              <Button Classes="secondary" Padding="7,2" Click="FixExportCompatibility_Click" Content="{Binding ExportCompatibilityActionText}" IsVisible="{Binding CanFixExportCompatibility}" chrome:WindowDecorationProperties.ElementRole="User" />
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel x:Name="ExportControls" Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" chrome:WindowDecorationProperties.ElementRole="User">
          <ComboBox
              Width="154"
              Height="30"
              VerticalAlignment="Center"
              ItemsSource="{Binding ExportPresets}"
              SelectedItem="{Binding SelectedExportPreset}" ToolTip.Tip="{Binding ExportPlanSummary}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="mediaExport:ExportPreset">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Border Height="30" CornerRadius="6" ClipToBounds="True">
            <Grid ColumnDefinitions="Auto,24">
              <Button
                  x:Name="ExportButton"
                  Height="30"
                  MinWidth="66"
                  Classes="primary command-bar"
                  CornerRadius="0"
                  Click="Export_Click"
                  Content="{Binding ExportActionText}"
                  IsEnabled="{Binding CanExport}"
                  ToolTip.Tip="{Binding ExportAvailabilityText}" />
              <Button
                  x:Name="ExportSettingsButton"
                  Grid.Column="1"
                  Width="24"
                  Height="30"
                  Classes="export-menu"
                  AutomationProperties.Name="Export settings"
                  ToolTip.Tip="{Binding ExportSettingsSummary}">
                <PathIcon Width="9" Height="6" Data="M1,1 L4.5,4.5 L8,1 Z" />
                <Button.Flyout>
                  <Flyout
                      Placement="BottomEdgeAlignedRight"
                      OverlayDismissEventPassThrough="True">
                    <Border
                        Width="430"
                        Padding="10"
                        Background="#222630"
                        BorderBrush="#3D4352"
                        BorderThickness="1"
                        CornerRadius="8">
                      <ScrollViewer MaxHeight="560" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <StackPanel Margin="0,0,4,0" Spacing="10">
                        <StackPanel Spacing="3">
                          <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#F5F5F8" Text="Export settings" />
                          <TextBlock Classes="muted" FontSize="11" Text="Adjust output size and compression before exporting." />
                        </StackPanel>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Destination" />
                          <ComboBox
                              Grid.Column="1"
                              ItemsSource="{Binding ExportDestinationChoices}"
                              SelectedItem="{Binding SelectedExportDestination}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:ExportDestinationChoice">
                                <TextBlock Text="{Binding DisplayName}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                        </Grid>
                        <TextBlock
                            Classes="muted"
                            FontSize="10"
                            Text="Clipboard exports are copied as files. Their size limit is in the bottom cog settings."
                            TextWrapping="Wrap" />

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,72" ColumnSpacing="8" RowSpacing="2">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Scale" />
                          <NumericUpDown
                              Grid.Column="1"
                              Height="26"
                              Padding="6,0"
                              Minimum="10"
                              Maximum="100"
                              Increment="1"
                              FormatString="0"
                              ShowButtonSpinner="False"
                              HorizontalContentAlignment="Right"
                              Background="#151820"
                              BorderBrush="#555C6C"
                              Foreground="#F5F5F8"
                              Value="{Binding ExportScalePercent, Mode=TwoWay}">
                            <NumericUpDown.InnerRightContent>
                              <TextBlock Margin="3,0,5,0" VerticalAlignment="Center" Foreground="#A8AFC0" Text="%" />
                            </NumericUpDown.InnerRightContent>
                          </NumericUpDown>
                          <Slider
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="20"
                              Margin="8,0"
                              Minimum="10"
                              Maximum="100"
                              SmallChange="1"
                              LargeChange="5"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              Value="{Binding ExportScaleSliderValue, Mode=TwoWay}" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,72" ColumnSpacing="8" RowSpacing="2">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Quality" />
                          <NumericUpDown
                              Grid.Column="1"
                              Height="26"
                              Padding="6,0"
                              Minimum="1"
                              Maximum="100"
                              Increment="1"
                              FormatString="0"
                              ShowButtonSpinner="False"
                              HorizontalContentAlignment="Right"
                              Background="#151820"
                              BorderBrush="#555C6C"
                              Foreground="#F5F5F8"
                              Value="{Binding ExportQuality, Mode=TwoWay}">
                            <NumericUpDown.InnerRightContent>
                              <TextBlock Margin="3,0,5,0" VerticalAlignment="Center" Foreground="#A8AFC0" Text="%" />
                            </NumericUpDown.InnerRightContent>
                          </NumericUpDown>
                          <Slider
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="20"
                              Margin="8,0"
                              Minimum="1"
                              Maximum="100"
                              SmallChange="1"
                              LargeChange="5"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              Value="{Binding ExportQualitySliderValue, Mode=TwoWay}" />
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,72" ColumnSpacing="8" RowSpacing="2">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Playback speed" />
                          <NumericUpDown
                              Grid.Column="1"
                              Height="26"
                              Padding="6,0"
                              Minimum="25"
                              Maximum="400"
                              Increment="5"
                              FormatString="0"
                              ShowButtonSpinner="False"
                              HorizontalContentAlignment="Right"
                              Background="#151820"
                              BorderBrush="#555C6C"
                              Foreground="#F5F5F8"
                              Value="{Binding ExportPlaybackSpeedPercent, Mode=TwoWay}">
                            <NumericUpDown.InnerRightContent>
                              <TextBlock Margin="3,0,5,0" VerticalAlignment="Center" Foreground="#A8AFC0" Text="%" />
                            </NumericUpDown.InnerRightContent>
                          </NumericUpDown>
                          <Slider
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="20"
                              Margin="8,0"
                              Minimum="25"
                              Maximum="400"
                              SmallChange="5"
                              LargeChange="25"
                              TickFrequency="5"
                              IsSnapToTickEnabled="True"
                              Value="{Binding ExportPlaybackSpeedSliderValue, Mode=TwoWay}" />
                        </Grid>

                        <Grid
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="*,72"
                            ColumnSpacing="8"
                            RowSpacing="2"
                            IsVisible="{Binding IsGifExport}">
                          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="GIF frame rate" />
                          <NumericUpDown
                              Grid.Column="1"
                              Height="26"
                              Padding="6,0"
                              Minimum="1"
                              Maximum="60"
                              Increment="1"
                              FormatString="0"
                              ShowButtonSpinner="False"
                              HorizontalContentAlignment="Right"
                              Background="#151820"
                              BorderBrush="#555C6C"
                              Foreground="#F5F5F8"
                              Value="{Binding GifFrameRate, Mode=TwoWay}" />
                          <Slider
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="20"
                              Margin="8,0"
                              Minimum="1"
                              Maximum="60"
                              SmallChange="1"
                              LargeChange="5"
                              TickFrequency="1"
                              IsSnapToTickEnabled="True"
                              Value="{Binding GifFrameRateSliderValue, Mode=TwoWay}" />
                        </Grid>

                        <Border
                            Padding="9"
                            Background="#1B1E26"
                            BorderBrush="#3A4050"
                            BorderThickness="1"
                            CornerRadius="7"
                            IsVisible="{Binding IsCustomExport}">
                          <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                              <TextBlock FontWeight="SemiBold" Foreground="#D8D0FF" Text="Custom format" />
                              <TextBlock Classes="muted" FontSize="10" Text="Only compatible codec combinations are shown." />
                            </StackPanel>
                            <Grid ColumnDefinitions="96,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="5">
                              <TextBlock VerticalAlignment="Center" Text="Container" />
                              <ComboBox Grid.Column="1" ItemsSource="{Binding CustomExportContainerChoices}" SelectedItem="{Binding CustomExportContainer}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ExportContainerChoice">
                                    <TextBlock Text="{Binding DisplayName}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Video codec" />
                              <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding CustomVideoCodecChoices}" SelectedItem="{Binding CustomVideoCodec}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:VideoCodecChoice">
                                    <TextBlock Text="{Binding DisplayName}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Audio codec" />
                              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CustomAudioCodecChoices}" SelectedItem="{Binding CustomAudioCodec}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:AudioCodecChoice">
                                    <TextBlock Text="{Binding DisplayName}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </Grid>
                            <CheckBox
                                Content="Use source frame rate"
                                IsChecked="{Binding CustomUseSourceFrameRate, Mode=TwoWay}"
                                IsVisible="{Binding CustomCanSetFrameRate}" />
                            <Grid
                                RowDefinitions="Auto,Auto"
                                ColumnDefinitions="*,72"
                                ColumnSpacing="8"
                                RowSpacing="2"
                                IsVisible="{Binding CustomUsesFixedFrameRate}">
                              <TextBlock VerticalAlignment="Center" Text="Frame rate" />
                              <NumericUpDown
                                  Grid.Column="1"
                                  Height="26"
                                  Padding="6,0"
                                  Minimum="1"
                                  Maximum="120"
                                  Increment="1"
                                  FormatString="0"
                                  ShowButtonSpinner="False"
                                  HorizontalContentAlignment="Right"
                                  Background="#151820"
                                  BorderBrush="#555C6C"
                                  Foreground="#F5F5F8"
                                  Value="{Binding CustomFrameRate, Mode=TwoWay}" />
                              <Slider
                                  Grid.Row="1"
                                  Grid.ColumnSpan="2"
                                  Height="20"
                                  Margin="8,0"
                                  Minimum="1"
                                  Maximum="120"
                                  SmallChange="1"
                                  LargeChange="5"
                                  TickFrequency="1"
                                  IsSnapToTickEnabled="True"
                                  Value="{Binding CustomFrameRateSliderValue, Mode=TwoWay}" />
                            </Grid>

                            <Separator Background="#3A4050" />
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="Saved presets" />
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                              <ComboBox ItemsSource="{Binding SavedExportPresets}" SelectedItem="{Binding SelectedSavedExportPreset}" PlaceholderText="Choose a preset">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:SavedExportPresetViewModel">
                                    <TextBlock Text="{Binding Name}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Button Grid.Column="1" Height="27" Padding="8,3" Classes="secondary" Click="LoadExportPreset_Click" Content="Load" IsEnabled="{Binding HasSelectedSavedExportPreset}" />
                              <Button Grid.Column="2" Width="27" Height="27" Padding="6" Classes="secondary" Click="DeleteExportPreset_Click" IsEnabled="{Binding HasSelectedSavedExportPreset}" ToolTip.Tip="Delete selected preset">
                                <PathIcon Width="12" Height="12" Data="M3,4 H13 M5,4 V14 H11 V4 M6,2 H10 L11,4 H5 Z" />
                              </Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                              <TextBox MaxLength="60" PlaceholderText="Preset name" Text="{Binding CustomPresetName, Mode=TwoWay}" />
                              <Button Grid.Column="1" Height="27" Padding="9,3" Classes="secondary" Click="SaveExportPreset_Click" Content="Save preset" IsEnabled="{Binding CanSaveCustomExportPreset}" />
                            </Grid>
                          </StackPanel>
                        </Border>

                        <Border Padding="8,5" Background="#171A21" BorderBrush="#353A47" BorderThickness="1" CornerRadius="6">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="muted" FontSize="11" Text="Final output size" />
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Foreground="#BBAEFF" Text="{Binding ExportOutputSizeText}" />
                          </Grid>
                        </Border>
                        <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="Lower scale and quality reduce file size. GIF quality controls the color palette." />
                      </StackPanel>
                      </ScrollViewer>
                    </Border>
                  </Flyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
          <Button
              x:Name="CancelExportButton"
              Height="30"
              Classes="secondary command-bar"
              Click="CancelExport_Click"
              Content="Cancel"
              IsVisible="{Binding CanCancelExport}" />
          <StackPanel
              x:Name="WindowsCaptionButtons"
              Height="47"
              Margin="6,0,-12,0"
              IsVisible="False"
              Orientation="Horizontal">
            <Button x:Name="MinimizeCaptionButton" Classes="caption" Click="MinimizeCaptionButton_Click" AutomationProperties.Name="Minimize window" ToolTip.Tip="Minimize" chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
              <PathIcon Width="11" Height="11" Data="M1,7 H10 V8 H1 Z" />
            </Button>
            <Button x:Name="MaximizeCaptionButton" Classes="caption" Click="MaximizeCaptionButton_Click" AutomationProperties.Name="Maximize or restore window" ToolTip.Tip="Maximize" chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
              <Grid>
                <PathIcon x:Name="MaximizeCaptionIcon" Width="11" Height="11" Data="M1,1 H10 V10 H1 Z M2,2 V9 H9 V2 Z" />
                <PathIcon x:Name="RestoreCaptionIcon" Width="11" Height="11" IsVisible="False" Data="M3,1 H10 V8 H8 V3 H3 Z M1,3 H8 V10 H1 Z M2,4 V9 H7 V4 Z" />
              </Grid>
            </Button>
            <Button x:Name="CloseCaptionButton" Classes="caption caption-close" Click="CloseCaptionButton_Click" AutomationProperties.Name="Close window" ToolTip.Tip="Close" chrome:WindowDecorationProperties.ElementRole="CloseButton">
              <PathIcon Width="11" Height="11" Data="M1,1.8 L1.8,1 L5.5,4.7 L9.2,1 L10,1.8 L6.3,5.5 L10,9.2 L9.2,10 L5.5,6.3 L1.8,10 L1,9.2 L4.7,5.5 Z" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="10" ColumnDefinitions="214,*" ColumnSpacing="10">
      <Border
          Grid.ColumnSpan="2"
          ZIndex="30"
          Margin="18"
          Padding="18"
          MaxWidth="760"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          Classes="panel"
          Background="#20242D"
          BorderBrush="#7C5CFC"
          IsVisible="{Binding HasPendingMissingMedia}">
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding PendingProjectOpenTitle}" />
          <TextBlock Classes="muted" Text="{Binding PendingProjectOpenDescription}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding MissingMediaReferences}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MissingMediaReferenceViewModel">
                <Border Margin="0,3" Padding="10,7" Background="#181B22" CornerRadius="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding DetailText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Classes="secondary"
                        Click="RelinkMissingMedia_Click"
                        Content="Relink…"
                        AutomationProperties.Name="{Binding DisplayName}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button
              HorizontalAlignment="Right"
              Classes="secondary"
              Click="CancelPendingProjectOpen_Click"
              Content="Cancel open"
              AutomationProperties.Name="Cancel opening project" />
        </StackPanel>
      </Border>

      <Border Grid.Column="0" Classes="panel" Padding="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Text="PROJECT MEDIA" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="#777E91"
                Text="{Binding MediaItems.Count}" />
          </Grid>

          <ListBox
              x:Name="ProjectMediaList"
              Grid.Row="1"
              Padding="0"
              Background="Transparent"
              BorderThickness="0"
              ItemsSource="{Binding MediaItems}"
              KeyDown="ProjectMedia_KeyDown"
              SelectedItem="{Binding SelectedMedia}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:MediaItemViewModel">
                <Border
                    Margin="0,0,0,6"
                    Padding="8"
                    Background="#20242D"
                    CornerRadius="6"
                    DoubleTapped="ProjectMediaItem_DoubleTapped"
                    ToolTip.Tip="Double-click to add another full-length instance to the timeline">
                  <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
                    <Border
                        Width="34"
                        Height="34"
                        Background="#2B3040"
                        CornerRadius="7">
                      <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="#A996FF"
                          Text="◆" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding DisplayName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Spacing="5">
            <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Button
                Classes="secondary"
                Click="OpenMedia_Click"
                Content="Add media"
                IsEnabled="{Binding IsImportAvailable}" />
            <Button
                Classes="secondary"
                Click="RemoveSelectedMedia_Click"
                Content="Remove selected"
                IsEnabled="{Binding CanRemoveSelectedMedia}"
                ToolTip.Tip="Removes the selected item from this project; the source file stays untouched" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Border
            Classes="panel"
            IsVisible="{Binding ShowEmptyState}">
          <Grid Margin="28">
            <Border
                MaxWidth="650"
                MaxHeight="560"
                Padding="44"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#151820"
                BorderBrush="#4C5264"
                BorderThickness="1"
                CornerRadius="18">
              <StackPanel HorizontalAlignment="Center" Spacing="16">
                <Border
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Background="#242033"
                    CornerRadius="36">
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      FontSize="34"
                      Foreground="#A996FF"
                      Text="▶" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="{Binding EmptyStateTitle}" />
                <TextBlock
                    MaxWidth="470"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding EmptyStateDescription}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />

                <Border
                    MinWidth="470"
                    MaxWidth="560"
                    Padding="10"
                    Background="#20242D"
                    BorderBrush="#7C5CFC"
                    BorderThickness="1"
                    CornerRadius="8"
                    IsVisible="{Binding HasRecoveryCandidates}">
                  <StackPanel Spacing="7">
                    <TextBlock FontWeight="SemiBold" Text="Recovery autosaves" />
                    <TextBlock Classes="muted" FontSize="11" Text="Nothing is restored automatically. Review the referenced media first." />
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding RecoveryCandidates}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:RecoveryCandidateViewModel">
                            <Border Margin="0,3" Padding="9,7" Background="#181B22" CornerRadius="6">
                              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <StackPanel>
                                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                  <TextBlock Classes="muted" FontSize="10" Text="{Binding ReferencedMediaText}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Classes="primary"
                                    Padding="9,5"
                                    Click="RecoverCandidate_Click"
                                    Content="Recover"
                                    IsEnabled="{Binding CanRecover}"
                                    AutomationProperties.Name="{Binding AutomationName}" />
                                <Button
                                    Grid.Column="2"
                                    Classes="secondary"
                                    Padding="9,5"
                                    Click="DiscardRecoveryCandidate_Click"
                                    Content="Discard"
                                    AutomationProperties.Name="{Binding AutomationName}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </StackPanel>
                </Border>

                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Classes="primary"
                    Click="OpenMedia_Click"
                    Content="Open media"
                    IsEnabled="{Binding IsImportAvailable}" />

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#767D91"
                    Text="{Binding SupportedMediaHint}" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Grid
            RowDefinitions="3*,2*"
            RowSpacing="10"
            IsVisible="{Binding ShowQuickWorkspace}">
          <Border Classes="panel" Padding="10">
            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
              <Border Background="#0B0D12" ClipToBounds="True" CornerRadius="8">
                <Grid>
                  <Image
                      Margin="5"
                      IsVisible="{Binding HasPreviewImage}"
                      Source="{Binding PreviewImage}"
                      Stretch="Uniform" />

                  <Border
                      Margin="5"
                      Background="#000000"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsPlaybackAvailable, ElementName=LivePreview}" />

                  <controls:MpvVideoView
                      x:Name="LivePreview"
                      Margin="5"
                      AudioTracks="{Binding PreviewAudioTracks}"
                      CanvasSize="{Binding CanvasSize}"
                      CanvasTransform="{Binding SelectedVideoClip.CanvasTransform}"
                      HasCuts="{Binding SelectedVideoClip.IsTrimmed}"
                      IsInteractiveTransformActive="{Binding IsClipTransformEditing}"
                      IsPaused="True"
                      PlaybackCompleted="LivePreview_PlaybackCompleted"
                      PlaybackRanges="{Binding SelectedVideoClip.PlaybackRanges}"
                      PlaybackSpeed="{Binding SelectedVideoClip.PlaybackSpeed}"
                      Position="{Binding SelectedMedia.Playhead, Mode=TwoWay}"
                      SourceVideoSize="{Binding SelectedVideoClip.VideoSize}"
                      SourcePath="{Binding SelectedMedia.SourcePath}" />

                  <Border
                      Margin="5"
                      Background="#000000"
                      IsHitTestVisible="False"
                      IsVisible="{Binding IsSequencePlayheadInGap}"
                      ZIndex="9" />

                  <controls:ClipTransformCanvas
                      Margin="5"
                      AutomationProperties.Name="Selected clip canvas transform"
                      CanvasSize="{Binding CanvasSize}"
                      IsActive="{Binding IsClipTransformOverlayActive}"
                      IsHitTestVisible="{Binding IsClipTransformOverlayActive}"
                      SourceSize="{Binding SelectedVideoClip.VideoSize}"
                      TransformEditCompleted="ClipTransformEditCompleted"
                      TransformEditStarted="ClipTransformEditStarted"
                      WheelRotationDegrees="{Binding ClipWheelRotationDegrees}"
                      WheelZoomPercent="{Binding ClipWheelZoomPercent}"
                      Transform="{Binding SelectedVideoClip.CanvasTransform, Mode=TwoWay}"
                      ToolTip.Tip="Drag clip to move · drag cyan handles to resize · Ctrl stretches · drag amber point to rotate"
                      ZIndex="11" />

                  <controls:CropCanvas
                      Margin="5"
                      AutomationProperties.Name="Video crop selection"
                      Crop="{Binding CanvasCrop, Mode=TwoWay}"
                      IsOverlayOnly="True"
                      IsAspectRatioLocked="{Binding IsCropAspectLocked}"
                      IsHitTestVisible="{Binding IsCropToolActive}"
                      SizeStep="{Binding CropSizeStep}"
                      ZIndex="10"
                      SourceSize="{Binding CanvasSize}"
                      ToolTip.Tip="Drag inside the crop to move it; drag a handle to resize" />

                  <controls:AutoCanvas
                      Margin="5"
                      AutomationProperties.Name="Automatic crop and clip canvas interaction"
                      CanvasSize="{Binding CanvasSize}"
                      Crop="{Binding CanvasCrop, Mode=TwoWay}"
                      CropSizeStep="{Binding CropSizeStep}"
                      IsCropAspectRatioLocked="{Binding IsCropAspectLocked}"
                      IsHitTestVisible="{Binding IsAutoCanvasOverlayActive}"
                      IsVisible="{Binding IsAutoCanvasOverlayActive}"
                      SourceSize="{Binding SelectedVideoClip.VideoSize}"
                      Transform="{Binding SelectedVideoClip.CanvasTransform, Mode=TwoWay}"
                      TransformEditCompleted="ClipTransformEditCompleted"
                      TransformEditStarted="ClipTransformEditStarted"
                      WheelRotationDegrees="{Binding ClipWheelRotationDegrees}"
                      WheelZoomPercent="{Binding ClipWheelZoomPercent}"
                      ZIndex="12" />

                  <Panel IsVisible="{Binding !IsPlaybackAvailable, ElementName=LivePreview}">
                    <StackPanel
                        HorizontalAlignment="Center"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Spacing="10"
                        IsVisible="{Binding ShowPreviewPlaceholder}">
                      <TextBlock
                          HorizontalAlignment="Center"
                          FontSize="42"
                          Foreground="#5D6374"
                          Text="▶" />
                      <TextBlock
                          MaxWidth="620"
                          HorizontalAlignment="Center"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Text="{Binding SelectedMedia.DisplayName}"
                          TextAlignment="Center"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          HorizontalAlignment="Center"
                          Classes="muted"
                          Text="{Binding SelectedMedia.Summary}" />
                      <TextBlock
                          HorizontalAlignment="Center"
                          FontSize="11"
                          Foreground="#6F7689"
                          Text="Decoding source frame…"
                          IsVisible="{Binding IsPreviewLoading}" />
                      <TextBlock
                          MaxWidth="560"
                          HorizontalAlignment="Center"
                          FontSize="11"
                          Foreground="#E28B8B"
                          Text="{Binding PreviewErrorText}"
                          TextAlignment="Center"
                          TextWrapping="Wrap"
                          IsVisible="{Binding HasPreviewError}" />
                    </StackPanel>
                  </Panel>

                  <Border
                      Margin="14"
                      Padding="8,5"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      ZIndex="20"
                      VerticalAlignment="Top"
                      Background="#B3151820"
                      CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock FontSize="10" Foreground="#AEB3C2" Text="SOURCE PREVIEW" />
                      <TextBlock
                          MaxWidth="520"
                          FontSize="10"
                          Foreground="#8D93A5"
                          Text="{Binding PlaybackStatus, ElementName=LivePreview}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          FontSize="10"
                          Foreground="#7C5CFC"
                          Text="{Binding DecoderStatus, ElementName=LivePreview}" />
                      <TextBlock
                          FontSize="10"
                          Foreground="#E3B341"
                          IsVisible="{Binding HasCuts, ElementName=LivePreview}"
                          Text="Cut preview sampled · export exact" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>

              <Slider
                  Grid.Row="1"
                  AutomationProperties.Name="Source playhead"
                  IsEnabled="{Binding SelectedMedia.HasEditableDuration}"
                  Maximum="{Binding SequenceDurationSeconds}"
                  Minimum="0"
                  Value="{Binding SequencePlayheadSeconds, Mode=TwoWay}" />

              <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="{Binding SequencePlayheadText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                  <Button AutomationProperties.Name="Go to start" Classes="secondary icon" Click="GoToStart_Click">
                    <PathIcon Width="14" Height="14" Data="M2,2 H4 V14 H2 Z M14,2 L6,8 L14,14 Z" />
                  </Button>
                  <Button
                      AutomationProperties.Name="Previous source frame"
                      Classes="secondary icon"
                      Click="StepFrameBackward_Click"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="Previous source frame (best effort)">
                    <PathIcon Width="13" Height="13" Data="M13,2 L4,8 L13,14 Z" />
                  </Button>
                  <Button
                      Width="36"
                      Height="30"
                      Padding="8"
                      AutomationProperties.Name="Play or pause"
                      Classes="primary"
                      Click="TogglePlayback_Click"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="{Binding PlaybackStatus, ElementName=LivePreview}">
                    <Grid>
                      <PathIcon Width="14" Height="14" Data="M3,2 L14,8 L3,14 Z" IsVisible="{Binding IsPaused, ElementName=LivePreview}" />
                      <PathIcon Width="14" Height="14" Data="M3,2 H7 V14 H3 Z M10,2 H14 V14 H10 Z" IsVisible="{Binding !IsPaused, ElementName=LivePreview}" />
                    </Grid>
                  </Button>
                  <Button
                      AutomationProperties.Name="Next source frame"
                      Classes="secondary icon"
                      Click="StepFrameForward_Click"
                      IsEnabled="{Binding IsPlaybackAvailable, ElementName=LivePreview}"
                      ToolTip.Tip="Next source frame">
                    <PathIcon Width="13" Height="13" Data="M3,2 L12,8 L3,14 Z" />
                  </Button>
                  <Button AutomationProperties.Name="Go to end" Classes="secondary icon" Click="GoToEnd_Click">
                    <PathIcon Width="14" Height="14" Data="M2,2 L10,8 L2,14 Z M12,2 H14 V14 H12 Z" />
                  </Button>
                </StackPanel>
                <Grid Grid.Column="2" ColumnDefinitions="Auto,70,Auto" ColumnSpacing="6" HorizontalAlignment="Right">
                  <TextBlock
                      VerticalAlignment="Center"
                      Classes="muted"
                      FontSize="9"
                      Text="VOLUME" />
                  <Slider
                      Grid.Column="1"
                      AutomationProperties.Name="Playback volume"
                      Minimum="0"
                      Maximum="1"
                      SmallChange="0.05"
                      ToolTip.Tip="Preview playback volume; export mix is unchanged"
                      Value="{Binding Volume, ElementName=LivePreview, Mode=TwoWay}" />
                  <TextBlock
                      Grid.Column="2"
                      MaxWidth="160"
                      VerticalAlignment="Center"
                      Classes="muted"
                      FontSize="11"
                      Text="{Binding SelectedMedia.Detail}"
                      TextTrimming="CharacterEllipsis" />
                </Grid>
              </Grid>
            </Grid>
          </Border>

          <Border Grid.Row="1" Classes="panel" Padding="10">
            <ScrollViewer
                x:Name="EditPaneScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <TextBlock FontSize="11" FontWeight="Bold" Text="EDIT" />
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="#777E91"
                    Text="{Binding EditingModeText}" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="10" Text="EXPORT" />
                  <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CanvasCropSizeText}" />
                  <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="10" Text="AUDIO" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding AudioSummaryText}" />
                </StackPanel>
                <ToggleButton
                    Grid.Column="3"
                    Height="24"
                    Padding="9,2"
                    Classes="secondary"
                    Click="ToggleAudioMixer_Click"
                    Content="Advanced"
                    IsChecked="{Binding IsAdvancedMode, Mode=OneWay}"
                    ToolTip.Tip="Show numeric crop/transform controls and the synchronized audio mixer" />
              </Grid>

              <Border Height="122" Padding="6" Background="#20242D" CornerRadius="6" IsVisible="{Binding ShowTimeline}">
                <Grid x:Name="TimelineLaneLayout" ColumnDefinitions="44,*" RowDefinitions="24,*" RowSpacing="3">
                  <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Spacing="5">
                    <TextBlock FontSize="11" FontWeight="Bold" Text="V1" />
                    <StackPanel Orientation="Horizontal" Spacing="2">
                      <Button Width="20" Height="22" Padding="4" Classes="secondary" Click="MoveVideoLeft_Click" IsEnabled="{Binding CanMoveSelectedVideoLeft}" ToolTip.Tip="Move selected clip left (Ctrl+Left)">
                        <PathIcon Width="10" Height="10" Data="M13,2 L4,8 L13,14 Z" />
                      </Button>
                      <Button Width="20" Height="22" Padding="4" Classes="secondary" Click="MoveVideoRight_Click" IsEnabled="{Binding CanMoveSelectedVideoRight}" ToolTip.Tip="Move selected clip right (Ctrl+Right)">
                        <PathIcon Width="10" Height="10" Data="M3,2 L12,8 L3,14 Z" />
                      </Button>
                    </StackPanel>
                  </StackPanel>
                  <Grid x:Name="TimelineToolbar" Grid.Column="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="4">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="muted" FontSize="9" Text="{Binding SequenceTimelineViewportText}" />
                      <TextBlock Classes="muted" FontSize="9" Text="Drag selects · Ctrl+drag moves · drag clip edges to trim" />
                    </StackPanel>
                    <Button x:Name="TimelineZoomOutButton" Grid.Column="1" Width="26" Classes="secondary timeline-tool" Click="TimelineZoomOut_Click" Content="−" FontSize="14" IsEnabled="{Binding CanZoomSequenceTimelineOut}" ToolTip.Tip="Zoom timeline out" />
                    <TextBlock Grid.Column="2" MinWidth="35" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding SequenceTimelineZoomText}" />
                    <Button x:Name="TimelineZoomInButton" Grid.Column="3" Width="26" Classes="secondary timeline-tool" Click="TimelineZoomIn_Click" Content="+" FontSize="14" IsEnabled="{Binding CanZoomSequenceTimelineIn}" ToolTip.Tip="Zoom timeline in" />
                    <ToggleButton x:Name="TimelinePointerModeToggle" Grid.Column="4" Width="58" Classes="secondary timeline-tool" AutomationProperties.Name="Timeline pointer mode" Content="{Binding TimelinePointerModeText}" IsChecked="{Binding MoveTimelineClipsByDefault, Mode=TwoWay}" ToolTip.Tip="Range: drag selects and Ctrl+drag moves. Move: drag clip bodies directly." />
                    <ToggleButton x:Name="TimelineSnappingToggle" Grid.Column="5" Width="26" Classes="secondary timeline-tool" AutomationProperties.Name="Timeline snapping" IsChecked="{Binding IsTimelineSnappingEnabled, Mode=TwoWay}" ToolTip.Tip="Snap nearby clip edges together; hold Alt while dragging to bypass">
                      <PathIcon Width="12" Height="12" Data="M2,1 H6 V7 A4,4 0 0 0 14,7 V1 H18 V7 A8,8 0 0 1 2,7 Z M2,1 H6 V4 H2 Z M14,1 H18 V4 H14 Z" />
                    </ToggleButton>
                    <ToggleButton x:Name="TimelineFreeModeToggle" Grid.Column="6" Width="44" Classes="secondary timeline-tool" Content="Free" IsChecked="{Binding IsSequenceTimelineFreeMode, Mode=TwoWay}" ToolTip.Tip="Show workspace before and after the sequence so clips and hidden handles can be moved freely" />
                    <Button x:Name="TimelineFitButton" Grid.Column="7" Width="34" Classes="secondary timeline-tool" Click="TimelineFit_Click" Content="Fit" />
                  </Grid>
                  <controls:SequenceTimelineCanvas
                      x:Name="SequenceTimeline"
                      PointerMoved="SequenceTimeline_PointerMoved"
                      Grid.Column="1"
                      Grid.Row="1"
                      AutomationProperties.Name="Video sequence timeline"
                      Clips="{Binding VideoClips}"
                      ClipMoveRequested="SequenceTimeline_ClipMoveRequested"
                      CopyRequested="SequenceTimeline_CopyRequested"
                      FreeViewport="{Binding IsSequenceTimelineFreeMode}"
                      DeleteRequested="SequenceTimeline_DeleteRequested"
                      Duration="{Binding SequenceDurationSeconds}"
                      HoverTime="{Binding TimelineHoverTime, Mode=TwoWay}"
                      MoveLeftRequested="SequenceTimeline_MoveLeftRequested"
                      MoveClipsByDefault="{Binding MoveTimelineClipsByDefault}"
                      MoveRightRequested="SequenceTimeline_MoveRightRequested"
                      PasteRequested="SequenceTimeline_PasteRequested"
                      Playhead="{Binding SequencePlayheadSeconds, Mode=TwoWay}"
                      SelectedClip="{Binding SelectedVideoClip, Mode=TwoWay}"
                      SnappingEnabled="{Binding IsTimelineSnappingEnabled}"
                      SelectionEnd="{Binding SequenceSelectionEndSeconds, Mode=TwoWay}"
                      SelectionStart="{Binding SequenceSelectionStartSeconds, Mode=TwoWay}"
                      SplitRequested="SequenceTimeline_SplitRequested"
                      ViewportStart="{Binding SequenceTimelineViewportStart, Mode=TwoWay}"
                      VisualRevision="{Binding SequenceTimelineVisualRevision}"
                      Zoom="{Binding SequenceTimelineZoom, Mode=TwoWay}" />
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="5" IsVisible="{Binding ShowTimeline}">
                <Button Classes="secondary" Click="MarkIn_Click" Content="Mark in" />
                <Button Grid.Column="1" Classes="secondary" Click="MarkOut_Click" Content="Mark out" />
                <Button Grid.Column="2" Classes="primary" Click="RemoveSelection_Click" Content="Remove selection" IsEnabled="{Binding CanRemoveSequenceSelection}" />
                <Button Grid.Column="3" Classes="primary" Click="KeepSelectionOnly_Click" Content="Keep selection" IsEnabled="{Binding CanKeepSequenceSelection}" />
                <Button Grid.Column="4" Classes="secondary" Click="SplitClip_Click" Content="Split" IsEnabled="{Binding CanSplitSelectedVideoClip}" ToolTip.Tip="Split at the playhead (S)" />
                <Button Grid.Column="5" Classes="secondary" Click="ResetCuts_Click" Content="Reset cuts" />
                <Button Grid.Column="6" HorizontalAlignment="Left" Classes="secondary" Click="DeleteSelectedClip_Click" Content="Delete clip" IsEnabled="{Binding CanDeleteSelectedVideoClip}" />
                <StackPanel Grid.Column="7" HorizontalAlignment="Right" Spacing="1">
                  <TextBlock HorizontalAlignment="Right" Classes="muted" FontSize="10" Text="{Binding SequenceSelectionRangeText}" />
                  <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Text="{Binding SequenceSelectedDurationText}" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5" IsVisible="{Binding IsAdvancedMode}">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="CROP" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="X" />
                <TextBox Grid.Column="2" Width="54" Text="{Binding CanvasCropX, Mode=TwoWay}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="Y" />
                <TextBox Grid.Column="4" Width="54" Text="{Binding CanvasCropY, Mode=TwoWay}" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="W" />
                <TextBox Grid.Column="6" Width="60" Text="{Binding CanvasCropWidth, Mode=TwoWay}" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="H" />
                <TextBox Grid.Column="8" Width="60" Text="{Binding CanvasCropHeight, Mode=TwoWay}" />
                <Button Grid.Column="9" Classes="secondary" Click="ResetCrop_Click" Content="Reset crop" />
              </Grid>

              <Grid
                  ColumnDefinitions="Auto,Auto,58,Auto,58,Auto,58,Auto,58,Auto,58,Auto,Auto,66,Auto,Auto,*"
                  ColumnSpacing="5"
                  IsVisible="{Binding ShowAdvancedClipControls}">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="11" Text="CLIP" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="X" />
                <TextBox Grid.Column="2" Text="{Binding SelectedVideoClip.CanvasOffsetX, Mode=TwoWay}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="Y" />
                <TextBox Grid.Column="4" Text="{Binding SelectedVideoClip.CanvasOffsetY, Mode=TwoWay}" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="W %" />
                <TextBox Grid.Column="6" Text="{Binding SelectedVideoClip.CanvasScaleXPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="H %" />
                <TextBox Grid.Column="8" Text="{Binding SelectedVideoClip.CanvasScaleYPercent, Mode=TwoWay}" />
                <TextBlock Grid.Column="9" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="ROTATE °" />
                <TextBox Grid.Column="10" Text="{Binding SelectedVideoClip.CanvasRotationDegrees, Mode=TwoWay}" />
                <Button
                    Grid.Column="11"
                    Width="30"
                    Padding="4,2"
                    Classes="secondary"
                    AutomationProperties.Name="Rotate selected clip clockwise"
                    Click="RotateSelectedClipClockwise_Click"
                    Content="90°"
                    ToolTip.Tip="Rotate the selected clip 90° clockwise" />
                <TextBlock Grid.Column="12" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="SPEED" />
                <NumericUpDown
                    Grid.Column="13"
                    Height="26"
                    Padding="4,0"
                    Minimum="25"
                    Maximum="400"
                    Increment="5"
                    FormatString="0"
                    ShowButtonSpinner="False"
                    HorizontalContentAlignment="Right"
                    Value="{Binding SelectedClipPlaybackSpeedPercent, Mode=TwoWay}">
                  <NumericUpDown.InnerRightContent>
                    <TextBlock Margin="2,0,3,0" VerticalAlignment="Center" Classes="muted" FontSize="9" Text="%" />
                  </NumericUpDown.InnerRightContent>
                </NumericUpDown>
                <Button
                    Grid.Column="14"
                    Padding="9,5"
                    Classes="secondary"
                    Click="FillClipCanvas_Click"
                    Content="Fill"
                    ToolTip.Tip="Center and fill the canvas" />
                <Button
                    Grid.Column="15"
                    Padding="9,5"
                    Classes="secondary"
                    Click="FitClipCanvas_Click"
                    Content="Fit"
                    ToolTip.Tip="Center and show the whole clip" />
                <TextBlock Grid.Column="16" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="{Binding CanvasSizeText}" />
              </Grid>

              <Border
                  x:Name="AudioMixerPanel"
                  Padding="7"
                  Background="#151820"
                  CornerRadius="7"
                  IsVisible="{Binding ShowAudioMixer}">
                <Grid RowDefinitions="Auto,*" RowSpacing="5">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock FontSize="11" FontWeight="Bold" Text="AUDIO TRACKS" />
                      <TextBlock Classes="muted" FontSize="9" Text="Synced to video timeline" />
                    </StackPanel>
                    <Button Grid.Column="1" Height="22" Padding="7,1" Classes="secondary" Click="RestoreAudioTracks_Click" Content="Restore tracks" IsEnabled="{Binding CanRestoreMissingAudioTracks}" ToolTip.Tip="Restore source audio lanes that were removed from the project mix" />
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="{Binding AudioTrackCountText}" />
                  </Grid>
                  <ScrollViewer Grid.Row="1" MaxHeight="210" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AudioTracks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AudioTrackViewModel">
                          <Border Margin="0,0,0,5" Padding="7" Background="#20242D" CornerRadius="6">
                            <Grid RowDefinitions="Auto,Auto,52,Auto" RowSpacing="4">
                              <Grid ColumnDefinitions="*,Auto,64,Auto,Auto,110,52,Auto,Auto" ColumnSpacing="6">
                                <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="muted" FontSize="10" IsVisible="{Binding IsExternal}" Text="Start (s)" />
                                <TextBox Grid.Column="2" Height="26" IsVisible="{Binding IsExternal}" Text="{Binding TimelineOffsetSeconds, Mode=TwoWay}" />
                                <CheckBox Grid.Column="3" VerticalAlignment="Center" Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Classes="muted" FontSize="9" Text="{Binding ContextualGainLabel}" ToolTip.Tip="{Binding ContextualGainTargetText}" />
                                <Slider Grid.Column="5" AutomationProperties.Name="{Binding ContextualGainLabel}" Minimum="-60" Maximum="12" Value="{Binding ContextualGainDb, Mode=TwoWay}" ToolTip.Tip="{Binding ContextualGainTargetText}" />
                                <TextBlock Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Text="{Binding ContextualGainText}" />
                                <Button Grid.Column="7" Height="24" Padding="7,1" Classes="secondary" Click="ToggleAudioClipMembership_Click" Content="{Binding ContextualClipActionText}" IsVisible="{Binding CanToggleContextualClip}" ToolTip.Tip="{Binding ContextualClipActionToolTip}" />
                                <Button Grid.Column="8" Width="24" Height="24" Padding="2,0" Classes="secondary" AutomationProperties.Name="Remove audio track" Click="RemoveAudioTrack_Click" Content="×" FontSize="14" ToolTip.Tip="Remove this complete audio lane from the project mix" />
                              </Grid>
                              <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                  <TextBlock Classes="muted" FontSize="9" Text="{Binding TimelineViewportText}" />
                                  <TextBlock Classes="muted" FontSize="9" IsVisible="{Binding IsWaveformLoading}" Text="Generating waveform…" />
                                  <TextBlock Foreground="#E88E8E" FontSize="9" IsVisible="{Binding HasWaveformError}" Text="Waveform unavailable" ToolTip.Tip="{Binding WaveformErrorText}" />
                                  <TextBlock Classes="muted" FontSize="9" IsVisible="{Binding IsWaveformDecimated}" Text="Waveform sampled at this zoom" />
                                </StackPanel>
                                <Button Grid.Column="1" Padding="8,1" Classes="secondary" Click="AudioTimelineZoomOut_Click" Content="−" IsEnabled="{Binding CanZoomTimelineOut}" ToolTip.Tip="Zoom waveform out" />
                                <TextBlock Grid.Column="2" MinWidth="35" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" Text="{Binding TimelineZoomText}" />
                                <Button Grid.Column="3" Padding="8,1" Classes="secondary" Click="AudioTimelineZoomIn_Click" Content="+" IsEnabled="{Binding CanZoomTimelineIn}" ToolTip.Tip="Zoom waveform in" />
                                <Button Grid.Column="4" Padding="8,1" Classes="secondary" Click="AudioTimelineFit_Click" Content="Fit" IsEnabled="{Binding CanZoomTimelineOut}" />
                              </Grid>
                              <controls:SourceRangeCanvas
                                  Grid.Row="2"
                                  AutomationProperties.Name="Audio audible ranges and silence selection"
                                  AutomationProperties.HelpText="Uses the shared video timeline viewport. Delete silences the selected range on this track."
                                  DeleteRequested="AudioTimeline_DeleteRequested"
                                  Duration="{Binding TimelineDurationSeconds}"
                                  FreeViewport="{Binding TimelineFreeViewport}"
                                  KeptRanges="{Binding TimelineKeptRanges}"
                                  Playhead="{Binding TimelinePlayheadSeconds, Mode=TwoWay}"
                                  SelectionEnd="{Binding TimelineSelectionEndSeconds, Mode=TwoWay}"
                                  SelectionStart="{Binding TimelineSelectionStartSeconds, Mode=TwoWay}"
                                  Step="{Binding FrameStepSeconds}"
                                  TimelineSegments="{Binding TimelineSegments}"
                                  TrackGainDb="{Binding GainDb}"
                                  ViewportStart="{Binding TimelineViewportStart, Mode=TwoWay}"
                                  VisualRevision="{Binding WaveformVisualRevision}"
                                  Waveforms="{Binding Waveforms}"
                                  Zoom="{Binding TimelineZoom, Mode=TwoWay}" />
                              <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <Button
                                    Classes="secondary"
                                    Click="RemoveAudioSelection_Click"
                                    Content="Silence selection"
                                    IsEnabled="{Binding CanSilenceTimelineSelection}" />
                                <Button Grid.Column="1" Classes="secondary" Click="ResetAudioTrack_Click" Content="Reset" IsEnabled="{Binding IsEdited}" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="{Binding OutputDurationText}" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border
        Grid.Row="2"
        Padding="10,0"
        Background="#181B22"
        BorderBrush="#292D38"
        BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,180,Auto" ColumnSpacing="10" VerticalAlignment="Center">
        <Button Width="24" Height="22" Padding="4" Classes="secondary" ToolTip.Tip="Controls and limits">
          <PathIcon Width="13" Height="13" Data="M8,1 L9.2,2.8 L11.4,2.6 L12.2,4.7 L14.2,5.7 L13.6,7.8 L15,9.5 L13.6,11.2 L14.2,13.3 L12.2,14.3 L11.4,16.4 L9.2,16.2 L8,18 L6.8,16.2 L4.6,16.4 L3.8,14.3 L1.8,13.3 L2.4,11.2 L1,9.5 L2.4,7.8 L1.8,5.7 L3.8,4.7 L4.6,2.6 L6.8,2.8 Z M8,6 A3.5,3.5 0 1 0 8,13 A3.5,3.5 0 1 0 8,6 Z" />
          <Button.Flyout>
            <Flyout Placement="TopEdgeAlignedLeft">
              <Border Width="310" Padding="10" Background="#20242D" CornerRadius="7">
                <StackPanel Spacing="7">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="Controls and limits" />
                  <Grid ColumnDefinitions="*,96" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5">
                    <TextBlock VerticalAlignment="Center" Text="Wheel zoom (%)" />
                    <NumericUpDown
                        Grid.Column="1"
                        Height="26"
                        Padding="6,0"
                        Minimum="1"
                        Maximum="50"
                        Increment="1"
                        ShowButtonSpinner="False"
                        HorizontalContentAlignment="Right"
                        Value="{Binding ClipWheelZoomPercent, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Shift+wheel rotate (°)" />
                    <NumericUpDown
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="26"
                        Padding="6,0"
                        Minimum="1"
                        Maximum="45"
                        Increment="1"
                        ShowButtonSpinner="False"
                        HorizontalContentAlignment="Right"
                        Value="{Binding ClipWheelRotationDegrees, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Clipboard export limit" />
                    <NumericUpDown
                        Grid.Row="2"
                        Grid.Column="1"
                        Height="26"
                        Padding="6,0"
                        Minimum="1"
                        Maximum="4096"
                        Increment="10"
                        FormatString="0"
                        ShowButtonSpinner="False"
                        HorizontalContentAlignment="Right"
                        Value="{Binding ClipboardExportMaximumMegabytes, Mode=TwoWay}">
                      <NumericUpDown.InnerRightContent>
                        <TextBlock Margin="3,0,5,0" VerticalAlignment="Center" Classes="muted" FontSize="10" Text="MB" />
                      </NumericUpDown.InnerRightContent>
                    </NumericUpDown>
                  </Grid>
                  <TextBlock Classes="muted" FontSize="10" Text="Handle resize keeps aspect · Ctrl stretches one axis" />
                  <Button
                      HorizontalAlignment="Left"
                      Padding="8,4"
                      Classes="secondary"
                      Click="ResetCanvasControls_Click"
                      Content="Reset defaults" />
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>
        <TextBlock Grid.Column="1" FontSize="11" Foreground="#777E91" Text="Local, private, and non-destructive" />
        <ProgressBar
            Grid.Column="2"
            Height="5"
            Maximum="1"
            Value="{Binding ExportProgress}"
            IsVisible="{Binding ShowExportProgress}" />
        <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
          <TextBlock FontSize="11" Foreground="#B7A9FF" Text="{Binding ExportPhaseText}" />
          <TextBlock FontSize="11" Foreground="#A2A8B8" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Border
        x:Name="TimelineHoverPreview"
        Grid.RowSpan="3"
        Width="180"
        Height="104"
        Padding="2"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Background="#F20B0D12"
        BorderBrush="#9DE7FF"
        BorderThickness="1"
        CornerRadius="5"
        IsHitTestVisible="False"
        IsVisible="{Binding HasTimelineHoverPreview}"
        ZIndex="100">
      <Image Source="{Binding TimelineHoverPreviewImage}" Stretch="UniformToFill" />
    </Border>

    <Grid
        x:Name="WindowsResizeGrips"
        Grid.RowSpan="3"
        IsVisible="False"
        ZIndex="200">
      <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="WindowResizeGrip_PointerPressed" />
      <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="WindowResizeGrip_PointerPressed" />
    </Grid>
  </Grid>
</Window>
